# PhishLens Configuration
# Copy this file to .env and fill in values as needed

# Optional: VirusTotal API Key (free at https://www.virustotal.com/gui/join-us)
# The app works fully without this key
VIRUSTOTAL_API_KEY=

# CORS allowed origins (comma-separated)
# Default allows localhost development servers
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
